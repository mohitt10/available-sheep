{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "host",
            "displayName": "Host compiler with Qt 6",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/gui-host",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "/usr/bin/g++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host",
            "configurePreset": "host"
        }
    ],
    "testPresets": [
        {
            "name": "host",
            "configurePreset": "host",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
